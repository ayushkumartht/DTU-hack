# Groq API key — used for story generation, scene planning, and the narration
# script. Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face access token — used to call the public Spaces for scene images
# and narration voice. A free account's default (read) token is enough:
# https://huggingface.co/settings/tokens
HF_TOKEN=

# When "true", /api/story/scenes/image skips the real Hugging Face Space call
# (billed GPU inference) and returns a local mock image instead. Leave this
# "true" while working on UI/layout; set to "false" to generate real images.
MOCK_SCENE_IMAGES=true

# Wan 2.1 image-to-video for /api/reel (the reel's cinematic clip), via the
# official Hugging Face Space Wan-AI/Wan2.1. Set to "false" to generate a real
# clip (takes 1-4 min on the free queue). Anything else skips Wan and the reel
# uses the still image with a Ken Burns pan. On any failure it falls back too.
MOCK_WAN_VIDEO=true
# Optional: use a different Wan 2.1 Space with the same endpoints.
WAN_SPACE=Wan-AI/Wan2.1

# Supabase (optional, dummy DB). Project Settings -> API in the Supabase
# dashboard. Leave blank and /api/db just reports "not connected".
SUPABASE_URL=
SUPABASE_ANON_KEY=

# When "true", /api/story/scenes/video skips the real LTX-Video Space call
# and each scene falls back to its static image (Ken Burns only, no motion).
# LTX-Video runs on ZeroGPU, a quota shared across every ZeroGPU Space on
# this account - leave this "true" unless you specifically want real clips.
MOCK_SCENE_VIDEO=true
